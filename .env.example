DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:5173
SITE_BASE_URL=http://localhost:5173

# Leave DB_ENGINE empty for SQLite local development.
DB_ENGINE=
DB_NAME=ohio_spa
DB_USER=ohio
DB_PASSWORD=ohio_dev_password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

CELERY_TASK_ALWAYS_EAGER=1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

FIREBASE_ENABLED=0
FIREBASE_SERVICE_ACCOUNT_FILE=tmp/firebase-config.json
FIREBASE_SERVICE_ACCOUNT_JSON=

CLOUDINARY_URL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OHIO DANANG <no-reply@ohio.local>

# Loyalty / password reset
LOYALTY_VND_PER_POINT=10000
PASSWORD_RESET_CODE_TTL_MINUTES=10
